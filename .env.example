# Restaurant365 OData API Credentials
# Copy this file to .env and fill in your values

# Your company subdomain — the part before .restaurant365.com in your login URL
# Example: if you log in at https://honestmarys.restaurant365.com, use "honestmarys"
R365_DOMAIN=your-subdomain

# Your R365 login username
R365_USERNAME=your-username

# Your R365 login password
R365_PASSWORD=your-password
